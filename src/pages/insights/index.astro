---
import { getCollection } from 'astro:content'; import Layout from '../../components/Layout.astro'; const posts=(await getCollection('insights')).sort((a,b)=>b.data.published.valueOf()-a.data.published.valueOf()); const readingTime=(body='')=>Math.max(1,Math.ceil(body.replace(/[`*_#>|\[\]()]/g,' ').trim().split(/\s+/).filter(Boolean).length/200));
---
<Layout title="Insights | Russell Tech" description="Practical thoughts on apps, websites, custom CMS development and digital products."><section class="page-hero shell insights-hero"><span class="eyebrow">A few thoughts</span><h1>Useful notes for<br /><span class="gradient-text">digital work.</span></h1><p class="lead">A small collection of practical thoughts on building better digital products and services, without making a meal of it.</p><div class="insights-status"><span>RT / TRANSMISSION LOG</span><span>{String(posts.length).padStart(2, '0')} notes</span></div></section><section class="section shell post-list"><div class="post-list-head"><span>Index / latest first</span><span aria-hidden="true">Signal received</span></div>{posts.map(post=><a class="post-row" href={`/insights/${post.id.replace(/\.md$/, '')}/`}><span class="eyebrow">{post.data.category} · {post.data.published.toLocaleDateString('en-GB',{month:'short',year:'numeric'})}</span><h2>{post.data.title}</h2><p>{post.data.description}</p><span class="post-meta">{readingTime(post.body)} min read</span><span class="post-arrow">↗</span></a>)}</section></Layout>
<style>.insights-hero{position:relative;overflow:hidden}.insights-hero::after{content:'';position:absolute;right:-8%;bottom:-30%;width:58%;height:80%;opacity:.32;transform:perspective(420px) rotateX(58deg);transform-origin:bottom;background:linear-gradient(rgba(69,217,255,.24) 1px,transparent 1px),linear-gradient(90deg,rgba(255,79,199,.18) 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(to top,black,transparent 82%);pointer-events:none}.insights-status{position:relative;z-index:1;display:flex;justify-content:space-between;max-width:650px;margin-top:3rem;padding:.75rem 0;border-top:1px solid rgba(69,217,255,.32);border-bottom:1px solid rgba(255,79,199,.28);color:var(--muted);font:.68rem var(--font-mono);letter-spacing:.1em;text-transform:uppercase}.insights-status span:first-child{color:var(--cyan)}.post-list{padding-top:2rem}.post-list-head{display:flex;justify-content:space-between;padding:0 0 .8rem;color:var(--muted);font:.68rem var(--font-mono);letter-spacing:.1em;text-transform:uppercase}.post-row{position:relative;display:grid;grid-template-columns:.25fr 1fr .8fr .1fr;gap:2rem;align-items:center;overflow:hidden;padding:2rem 0;border-top:1px solid var(--line);text-decoration:none;transition:transform .35s cubic-bezier(.2,.75,.25,1),border-color .35s ease,background .35s ease}.post-row::before{content:'';position:absolute;inset:0;z-index:1;pointer-events:none;opacity:0;background:repeating-linear-gradient(to bottom,rgba(255,255,255,.14) 0 1px,transparent 1px 4px);mix-blend-mode:screen}.post-row:hover{transform:translateX(.45rem);border-color:rgba(69,217,255,.58);background:linear-gradient(90deg,rgba(69,217,255,.07),transparent 56%,rgba(255,79,199,.07))}.post-row:hover::before{opacity:1;animation:rt-interactive-glitch .9s steps(2,end) infinite}.post-row h2{position:relative;z-index:0;margin:0;font-size:clamp(1.5rem,3vw,2.5rem);transition:text-shadow .2s ease}.post-row:hover h2{text-shadow:-.08em 0 rgba(69,217,255,.85),.08em 0 rgba(255,79,199,.85)}.post-row p{position:relative;z-index:0;margin:0}.post-arrow{position:relative;z-index:0;color:var(--cyan);font-size:1.5rem;transition:transform .25s steps(2,end),color .25s ease}.post-row:hover .post-arrow{color:var(--pink);transform:translateX(.35rem) scale(1.2)}@media(max-width:700px){.insights-status{margin-top:2rem}.insights-hero::after{right:-35%;width:90%;opacity:.24}.post-list-head{font-size:.6rem}.post-row{grid-template-columns:1fr .1fr;gap:.75rem 1rem}.post-row .eyebrow,.post-row p{grid-column:1}.post-row h2{grid-column:1}.post-row .post-arrow{grid-column:2;grid-row:1/4;align-self:center}}
.post-meta{position:relative;z-index:0;color:var(--muted);font:.68rem var(--font-mono);letter-spacing:.08em;text-transform:uppercase}@media(max-width:700px){.post-row .post-meta{grid-column:1}.post-row .post-arrow{grid-row:1/5}}
</style>
