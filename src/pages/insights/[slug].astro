---
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('insights');
  return posts.map(post => ({ params: { slug: post.id.replace(/\.md$/, '') }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, published, category } = post.data;
const slug = post.id.replace(/\.md$/, '');
const wordCount = (post.body ?? '').replace(/[`*_#>|\[\]()]/g, ' ').trim().split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(wordCount / 200));
---
<Layout title={`${title} | Russell Tech`} description={description} type="article" schema={{ '@type': 'Article', headline: title, description, datePublished: published.toISOString(), author: { '@type': 'Person', name: 'Aaron Russell', url: 'https://aaron-russell.co.uk' }, publisher: { '@type': 'Organization', name: 'Russell Tech', url: 'https://russell-tech.co.uk/', logo: { '@type': 'ImageObject', url: 'https://russell-tech.co.uk/logo.png' } }, mainEntityOfPage: `https://russell-tech.co.uk/insights/${slug}/` }}>
  <article class="article-page shell"><div class="reading-progress" data-reading-progress><span class="sr-only">Reading progress</span><div class="reading-progress-track"><span data-reading-progress-bar></span></div><span class="reading-progress-value" data-reading-progress-value>0%</span></div><a class="muted-link" href="/insights/">← All insights</a><span class="eyebrow">{category} · <time datetime={published.toISOString()}>{published.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}</time></span><h1>{title}</h1><div class="article-meta"><span>{readingMinutes} min read</span><span>{wordCount} words</span></div><aside class="article-tldr"><span class="eyebrow">TL;DR</span><p>{description}</p></aside><div class="prose"><Content /></div></article>
</Layout>
<script>
  const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
  const bar = document.querySelector<HTMLElement>('[data-reading-progress-bar]');
  const value = document.querySelector<HTMLElement>('[data-reading-progress-value]');
  const updateProgress = () => {
    const article = document.querySelector<HTMLElement>('.article-page');
    if (!article || !bar || !value) return;
    const available = article.scrollHeight - window.innerHeight;
    const percentage = available > 0 ? Math.min(100, Math.max(0, (window.scrollY - article.offsetTop) / available * 100)) : 100;
    bar.style.width = `${percentage}%`;
    value.textContent = `${Math.round(percentage)}%`;
    progress?.classList.toggle('is-complete', percentage >= 99);
  };
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress);
  updateProgress();
</script>
<style>.article-page{position:relative;padding:4rem 0 8rem}.article-page>.eyebrow{display:block;margin-top:5rem}.article-page h1{max-width:900px;margin:1.3rem 0}.article-page .prose{margin-top:3.5rem}.article-meta{display:flex;gap:1rem;color:var(--muted);font:.7rem var(--font-mono);letter-spacing:.08em;text-transform:uppercase}.article-meta span+span{border-left:1px solid var(--line);padding-left:1rem}.article-tldr{max-width:780px;margin-top:3rem;padding:1.5rem 1.75rem;border:1px solid rgba(69,217,255,.28);border-left:3px solid var(--cyan);background:linear-gradient(100deg,rgba(69,217,255,.08),rgba(169,74,244,.06))}.article-tldr .eyebrow{display:block;margin:0 0 .8rem}.article-tldr p{margin:0;color:var(--ink);font-size:1.08rem}.reading-progress{position:fixed;z-index:20;top:0;left:0;right:0;display:flex;align-items:center;gap:.75rem;height:2.25rem;padding:0 max(20px,calc((100vw - var(--max)) / 2));background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(10px);opacity:.92}.reading-progress-track{height:3px;flex:1;overflow:hidden;background:var(--line)}.reading-progress-track span{display:block;width:0;height:100%;background:var(--accent-gradient);transition:width .12s linear}.reading-progress-value{min-width:2.5rem;color:var(--cyan);font:.65rem var(--font-mono);text-align:right}.reading-progress.is-complete .reading-progress-value{color:var(--mint)}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}@media(max-width:700px){.article-page{padding-top:3.5rem}.article-page>.eyebrow{margin-top:4rem}.article-tldr{padding:1.25rem;margin-top:2.25rem}.reading-progress{height:2rem}.article-meta{font-size:.62rem}}</style>
