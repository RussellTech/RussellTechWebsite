---
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import { isActiveProject } from '../../data/projects';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter(project => isActiveProject(project.id.replace(/\.md$/, '')))
    .map(project => ({ params: { slug: project.id.replace(/\.md$/, '') }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, client, category, summary, accent, tags, year, image, imageAlt } = project.data;
const imageBase = image?.replace(/\.[^/.]+$/, '');
const slug = project.id.replace(/\.md$/, '');
---
<Layout title={`${title} case study | Russell Tech`} description={summary} type="article" schema={{ '@type': 'CreativeWork', '@id': `https://russell-tech.co.uk/projects/${slug}/#project`, name: title, description: summary, url: `https://russell-tech.co.uk/projects/${slug}/`, creator: { '@type': 'Organization', name: 'Russell Tech', url: 'https://russell-tech.co.uk/' }, about: category }}>
  <article><header class="project-hero shell"><a class="muted-link" href="/projects/">← All projects</a><span class="eyebrow case-study-label">Case study · {category}</span><div class={`project-visual interactive-visual ${accent}${image ? ' has-image' : ''}`}>{image ? <picture><source srcset={`${imageBase}.avif`} type="image/avif" /><source srcset={`${imageBase}.webp`} type="image/webp" /><img src={image} alt={imageAlt ?? `${title} project screenshot`} loading="eager" fetchpriority="high" decoding="async" /></picture> : <div class="project-ui glass"><span></span><span></span><span></span><strong>{category}</strong></div>}<div class="project-visual-copy"><span class="eyebrow project-visual-eyebrow">{client}</span><h1 class="project-visual-title">{title}</h1><p class="lead">{summary}</p><div class="tag-row">{tags.map(tag => <span class="tag">{tag}</span>)}</div></div></div></header><section class="section shell project-content"><div class="prose"><Content /></div><aside class="project-sidebar"><div class="project-summary"><span class="eyebrow">Project snapshot</span><ul class="pill-list"><li><span>Client</span><strong>{client}</strong></li><li><span>Type</span><strong>{category}</strong></li>{year && <li><span>Year</span><strong>{year}</strong></li>}</ul></div><div class="project-sidebar-cta"><span class="eyebrow">Have a similar challenge?</span><h2>Let’s talk it through.</h2><a class="button primary" href="/contact/">Start a conversation ↗</a></div></aside></section></article>
</Layout>
<style>.project-hero{padding:4rem 0 2rem}.case-study-label{display:block;margin-top:5rem}.project-hero>.project-visual{margin:2rem 0 3rem;min-height:420px;align-items:end}.project-visual-copy{position:relative;z-index:1;max-width:760px;padding:1.5rem}.project-visual-copy .eyebrow{display:block;color:rgba(255,255,255,.78)}.project-visual-copy h1{margin:.7rem 0 1rem;color:#fff;font-size:clamp(3rem,8vw,7rem);line-height:.85;letter-spacing:-.08em;text-shadow:0 .08em .2em rgba(0,0,0,.45)}.project-visual-copy .lead{margin:0;max-width:680px;color:rgba(255,255,255,.86);text-shadow:0 .08em .2em rgba(0,0,0,.45)}.project-visual-copy .tag-row{margin-top:1.2rem}.project-visual-copy .tag{color:#fff;border-color:rgba(255,255,255,.42);background:rgba(3,9,20,.42)}.project-content{display:grid;grid-template-columns:1fr .35fr;gap:7rem;border-top:1px solid var(--line)}.project-sidebar{display:grid;align-content:start;gap:4rem;padding-top:1rem}.project-summary{padding-bottom:2rem;border-bottom:1px solid var(--line)}.project-sidebar-cta{padding:1.5rem;border:1px solid var(--line);border-radius:1.25rem;background:var(--panel)}.project-sidebar-cta h2{margin:1rem 0 1.5rem;font-size:clamp(1.8rem,3vw,2.6rem)}@media(max-width:800px){.project-content{grid-template-columns:1fr;gap:2rem}.project-hero>.project-visual{min-height:280px}.project-visual-copy{padding:1rem}.project-visual-copy h1{font-size:clamp(2.5rem,14vw,5rem)}.project-sidebar{gap:2rem}}
</style>
