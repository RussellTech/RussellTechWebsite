---
import { getCollection } from 'astro:content'; import Layout from '../components/Layout.astro'; import ProjectCard from '../components/ProjectCard.astro'; import CookieNotice from '../components/CookieNotice.astro';
const projects = (await getCollection('projects')).filter(project => project.data.featured);
---
<script>
  const initialiseHeroCode = () => {
    const panel = document.querySelector<HTMLElement>('.hero-orbit-label');
    if (!panel) return;
    const screen = panel.closest<HTMLElement>('.hero-orbit');
    const lines = [
      '<span class="code-prompt">&gt;</span> <span class="code-command">boot</span> <span class="code-value">russell_tech</span>',
      '<span class="code-ok">[OK]</span> loading <span class="code-value">digital_systems</span>',
      '<span class="code-ok">[OK]</span> checking <span class="code-value">accessibility</span>',
      '<span class="code-ok">[OK]</span> compiling <span class="code-value">useful_ideas</span>',
      '',
      '<span class="code-keyword">const</span> <span class="code-name">build</span> = (<span class="code-arg">problem</span>) =&gt; {',
      '  <span class="code-keyword">return</span> <span class="code-arg">problem</span>',
      '    .<span class="code-method">understand</span>()',
      '    .<span class="code-method">design</span>()',
      '    .<span class="code-method">test</span>()',
      '    .<span class="code-method">ship</span>();',
      '};',
      '',
      '<span class="code-keyword">if</span> (<span class="code-arg">ideas</span>) {',
      '  <span class="code-method">make_useful</span>(<span class="code-arg">ideas</span>);',
      '}',
      '',
      '<span class="code-keyword">const</span> <span class="code-name">signal</span> = {',
      '  <span class="code-name">mode</span>: <span class="code-value">"properly"</span>,',
      '  <span class="code-name">status</span>: <span class="code-value">"online"</span>,',
      '  <span class="code-name">tests</span>: <span class="code-value">"passing"</span>,',
      '};',
      '<span class="code-keyword">export</span> <span class="code-keyword">default</span> <span class="code-name">build</span>;',
      '',
      '<span class="code-comment">// shipping useful things since 2006</span>',
      '<span class="code-keyword">function</span> <span class="code-name">launch</span>(<span class="code-arg">project</span>) {',
      '  <span class="code-keyword">const</span> <span class="code-name">plan</span> = <span class="code-method">clarify</span>(<span class="code-arg">project</span>);',
      '  <span class="code-keyword">const</span> <span class="code-name">design</span> = <span class="code-method">make_clear</span>(<span class="code-name">plan</span>);',
      '  <span class="code-keyword">const</span> <span class="code-name">build</span> = <span class="code-method">make_real</span>(<span class="code-name">design</span>);',
      '  <span class="code-keyword">return</span> <span class="code-method">ship</span>(<span class="code-name">build</span>);',
      '}',
      '',
      '<span class="code-name">pipeline</span>.on(<span class="code-value">"success"</span>, () =&gt; {',
      '  <span class="code-method">log</span>(<span class="code-value">"ready for real people"</span>);',
      '  <span class="code-method">deploy</span>({ <span class="code-name">region</span>: <span class="code-value">"uk"</span> });',
      '});',
      '',
      '<span class="code-status">[PASS]</span> accessibility checks',
      '<span class="code-status">[PASS]</span> responsive layout',
      '<span class="code-status">[PASS]</span> production build',
      '<span class="code-status">[READY]</span> waiting for signal...',
      '',
      '<span class="code-prompt">&gt;</span> <span class="code-status">STATUS: ONLINE</span>',
    ];
    const output = document.createElement('div');
    output.className = 'hero-code';
    output.setAttribute('aria-hidden', 'true');
    lines.forEach((line) => {
      const row = document.createElement('div');
      row.className = 'hero-code-line';
      row.innerHTML = line || '&nbsp;';
      row.style.setProperty('--chars', String(Math.max(row.textContent?.length ?? 1, 1)));
      output.appendChild(row);
    });
    panel.replaceChildren(output);
    if (screen && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const scheduleCrtBurst = () => {
        window.setTimeout(() => {
          screen.classList.remove('crt-burst');
          void screen.offsetWidth;
          screen.classList.add('crt-burst');
          window.setTimeout(() => screen.classList.remove('crt-burst'), 260);
          scheduleCrtBurst();
        }, 4800 + Math.random() * 5200);
      };
      scheduleCrtBurst();
    }
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      output.querySelectorAll('.hero-code-line').forEach((row) => row.classList.add('is-typed'));
      return;
    }
    let lineIndex = 0;
    const typeNext = () => {
      const row = output.children[lineIndex] as HTMLElement | undefined;
      if (row) {
        row.classList.add('is-typed');
        row.classList.remove('code-glitch');
        void row.offsetWidth;
        row.classList.add('code-glitch');
        if (lineIndex >= 10) {
          output.scrollTop = Math.max(0, row.offsetTop - output.clientHeight + row.offsetHeight * 2);
        }
      }
      lineIndex += 1;
      if (lineIndex < lines.length) {
        const nextRow = output.children[lineIndex - 1] as HTMLElement | undefined;
        const typeTime = Math.max((nextRow?.textContent?.length ?? 1) * 28, 115);
        window.setTimeout(typeNext, typeTime + 90);
      } else {
        window.setTimeout(() => {
          output.querySelectorAll('.hero-code-line').forEach((item) => item.classList.remove('is-typed'));
          output.scrollTop = 0;
          lineIndex = 0;
          typeNext();
        }, 2300);
      }
    };
    typeNext();
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initialiseHeroCode, { once: true });
  } else {
    initialiseHeroCode();
  }
</script>
<style>
  .hero-kicker::before { content: 'SYS / 01'; color: var(--pink); }
  .hero-kicker { gap: .8rem; }
  .hero-kicker::after { content: 'SIGNAL: ONLINE'; margin-left: .35rem; color: var(--cyan); }
  .hero-orbit { border: 1px solid rgba(69, 217, 255, .45); border-radius: 1rem; transform: rotate(-5deg); background: linear-gradient(rgba(69, 217, 255, .06) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 79, 199, .06) 1px, transparent 1px), radial-gradient(circle at 32% 28%, rgba(69, 217, 255, .28), transparent 29%), radial-gradient(circle at 72% 66%, rgba(169, 74, 244, .26), transparent 37%), linear-gradient(135deg, rgba(7, 16, 31, .9), rgba(38, 18, 70, .76)); background-size: 46px 46px, 46px 46px, auto, auto, auto; box-shadow: 7px 7px 0 rgba(255, 79, 199, .12), 0 0 50px rgba(69, 217, 255, .12); }
  .hero-orbit::before { inset: 12%; border-radius: 0; transform: rotate(45deg); border-color: rgba(69, 217, 255, .5); }
  .hero-orbit::after { inset: 25%; border-radius: 50%; border-color: rgba(255, 79, 199, .5); transform: rotate(0); }
  .hero-orbit-label { display: block !important; top: 22%; left: 14%; width: 72%; color: var(--cyan); transform: none; }
  .hero-orbit-label::before, .hero-orbit-label::after, .hero-orbit-label strong { display: none; }
  .hero-code { margin: 0; color: var(--cyan); font: .62rem/1.75 var(--font-mono); letter-spacing: .04em; white-space: pre-wrap; text-shadow: 2px 0 rgba(255, 79, 199, .35); }
  .hero-code::after { content: '█'; color: var(--pink); animation: rt-code-cursor .85s steps(2, end) infinite; }
  .hero-orbit > span { border-radius: 0; transform: rotate(45deg); }
  .hero::after { opacity: .5; background-size: 46px 46px; }
  @keyframes rt-code-scroll { from { transform: translateY(0); } to { transform: translateY(-2.2rem); } }
  @keyframes rt-code-cursor { 0%, 48% { opacity: 1; } 49%, 100% { opacity: 0; } }
  .hero-copy::before {
    content: '> boot russell_tech\\A [ok] loading digital systems\\A [ok] checking accessibility\\A [ok] compiling useful ideas\\A\\A const build = (problem) => {\\A   return problem\\A     .understand()\\A     .test()\\A     .ship();\\A };\\A\\A STATUS: ONLINE';
    position: absolute;
    top: 8.5rem;
    left: 4rem;
    z-index: 0;
    width: 27rem;
    color: var(--cyan);
    font: .68rem/1.7 var(--font-mono);
    letter-spacing: .04em;
    white-space: pre;
    opacity: .16;
    text-shadow: 2px 0 rgba(255, 79, 199, .35);
    pointer-events: none;
    animation: rt-code-scroll 8s linear infinite alternate;
  }
  .hero-copy::after {
    content: '_';
    position: absolute;
    top: 25.2rem;
    left: 4rem;
    z-index: 0;
    color: var(--pink);
    font: .8rem var(--font-mono);
    opacity: .6;
    pointer-events: none;
    animation: rt-code-cursor .85s steps(2, end) infinite;
  }
  .hero-copy > * { position: relative; z-index: 1; }
  @media (max-width: 800px) {
    .hero-kicker::before, .hero-kicker::after { display: none !important; }
    .hero-copy::before { top: 10rem; left: 1rem; opacity: .09; transform: scale(.9); transform-origin: top left; }
    .hero-copy::after { top: 26rem; left: 1rem; opacity: .35; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-copy::before, .hero-copy::after, .hero-code::after { animation: none; }
  }
  .hero-orbit {
    border-radius: .7rem !important;
    transform: none !important;
    background: linear-gradient(145deg, #06101f, #101b3a 58%, #28133f) !important;
    box-shadow: 8px 8px 0 rgba(255, 79, 199, .14), 0 0 50px rgba(69, 217, 255, .16) !important;
    animation: none !important;
  }
  .hero-orbit::before {
    inset: .7rem !important;
    z-index: 1;
    border: 1px solid rgba(69, 217, 255, .45);
    border-radius: .3rem !important;
    transform: none !important;
    box-shadow: inset 0 0 0 4px rgba(3, 9, 20, .35), 0 0 22px rgba(69, 217, 255, .12) !important;
  }
  .hero-orbit::after {
    inset: .7rem !important;
    z-index: 3;
    border: 0 !important;
    border-radius: .3rem !important;
    transform: none !important;
    background: repeating-linear-gradient(to bottom, rgba(255, 255, 255, .06) 0 1px, transparent 1px 4px) !important;
    opacity: .18 !important;
    pointer-events: none;
    animation: none !important;
  }
  .hero-orbit-label {
    top: 12% !important;
    left: 11% !important;
    z-index: 2;
    width: 78% !important;
    height: 76% !important;
    padding: 2.2rem 1rem 1rem;
    overflow: hidden !important;
    border-radius: .2rem;
    background: rgba(3, 9, 20, .38) !important;
  }
  .hero-orbit-label::before {
    content: 'RT TERMINAL // LIVE BUILD';
    position: absolute;
    top: .65rem;
    left: 1rem;
    display: block;
    color: var(--pink);
    font: .55rem var(--font-mono);
    letter-spacing: .1em;
  }
  .hero-orbit-label::after {
    content: 'REC ● 1985';
    position: absolute;
    top: .65rem;
    right: 1rem;
    display: block;
    color: var(--cyan);
    font: .55rem var(--font-mono);
    letter-spacing: .08em;
  }
  .hero-code { height: 100%; overflow-y: auto; overflow-x: hidden; scrollbar-width: none; color: #9defff; font-size: .58rem; line-height: 1.65; text-shadow: none; }
  .hero-code::-webkit-scrollbar { display: none; }
  .hero-code-line { min-height: 1.65em; opacity: 0; clip-path: inset(0 100% 0 0); transform: translateX(-.25rem); }
  .hero-code-line.is-typed { opacity: 1; clip-path: inset(0 0 0 0); transform: translateX(0); animation: rt-code-line-type calc(var(--chars) * .028s) steps(var(--chars), end) both; }
  .hero-code .code-prompt, .hero-code .code-command { color: var(--pink) !important; }
  .hero-code .code-ok, .hero-code .code-status { color: var(--mint) !important; }
  .hero-code .code-keyword { color: #ff8bdc !important; }
  .hero-code .code-name, .hero-code .code-method { color: #7edfff !important; }
  .hero-code .code-value, .hero-code .code-arg { color: var(--gold) !important; }
  .code-glitch { animation: rt-terminal-glitch .24s steps(2, end); }
  @keyframes rt-code-line-in { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes rt-code-line-type { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes rt-terminal-glitch { 0%, 100% { filter: none; transform: translateX(0); } 25% { filter: drop-shadow(-2px 0 rgba(69, 217, 255, .8)) drop-shadow(2px 0 rgba(255, 79, 199, .8)); transform: translateX(-.12rem); } 55% { filter: none; transform: translateX(.1rem); } }
  @keyframes rt-screen-flicker { 0%, 92%, 100% { opacity: .5; } 94% { opacity: .72; } 96% { opacity: .38; } }
  @media (prefers-reduced-motion: reduce) { .hero-orbit::after, .hero-code-line.is-typed, .code-glitch { animation: none; } }
</style>
