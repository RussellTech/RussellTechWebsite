<aside class="cookie-notice" data-cookie-notice hidden><p><strong>Privacy, by default.</strong> If enabled, Russell Tech uses privacy-focused, cookieless analytics to understand aggregate site traffic. <a href="/privacy/">Read the privacy note</a>.</p><button type="button" data-cookie-dismiss>Got it</button></aside>
<script>const notice=document.querySelector('[data-cookie-notice]');if(notice&&!localStorage.getItem('rt-privacy-notice'))notice.removeAttribute('hidden');document.querySelector('[data-cookie-dismiss]')?.addEventListener('click',()=>{localStorage.setItem('rt-privacy-notice','seen');notice?.setAttribute('hidden','')});</script>
<style>.cookie-notice{position:fixed;z-index:5;right:1rem;bottom:1rem;display:flex;align-items:center;gap:1rem;max-width:480px;padding:1rem;border:1px solid var(--line);border-radius:1rem;background:var(--panel);box-shadow:0 20px 60px #0008,0 0 28px rgba(169,74,244,.1)}.cookie-notice[hidden]{display:none}.cookie-notice p{margin:0;font-size:.78rem}.cookie-notice strong,.cookie-notice a{color:var(--ink)}.cookie-notice button{border:0;border-radius:999px;padding:.55rem .8rem;color:var(--button-ink);background:var(--accent-gradient);font-weight:700;white-space:nowrap;cursor:pointer}@media(max-width:500px){.cookie-notice{left:1rem;display:block}.cookie-notice button{margin-top:.75rem}}
</style>
