{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "russell-tech",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
