{
  "name": "russell-tech",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "scripts": {
    "brand:generate": "node scripts/generate-brand-assets.mjs",
    "dev": "astro dev",
    "build": "wrangler types && astro check && node scripts/optimize-images.mjs && astro build && node scripts/generate-social-images.mjs && node scripts/check-generated-routes.mjs",
    "preview": "astro preview",
    "social:generate": "node scripts/generate-social-images.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "test:security": "vitest run tests/contact-security.test.mjs",
    "test:watch": "vitest",
    "check:routes": "node scripts/check-generated-routes.mjs",
    "typecheck": "astro check",
    "verify:security": "node scripts/verify-security-build.mjs",
    "wrangler:types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.5.0",
    "astro": "^7.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@playwright/test": "^1.64.1",
    "@vitest/coverage-v8": "^5.0.5",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
